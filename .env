# ============================================
# CONFIGURAÇÕES DO WHATSAPP
# ============================================

# Número do bot no WhatsApp (com código do país)
WHATSAPP_NUMBER=5544999943206

# Nome do bot
BOT_NAME=JOAO STORE BOT

# ============================================
# CONFIGURAÇÕES DO ADMIN
# ============================================

# Número do administrador (seu número)
ADMIN_NUMBER=5544999943206

# ============================================
# CONFIGURAÇÕES DO MERCADO PAGO
# ============================================

# Token de acesso da API Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=APP_USR-SEU-TOKEN-AQUI

# Chave pública do Mercado Pago
MERCADOPAGO_PUBLIC_KEY=APP_USR-SUA-CHAVE-AQUI

# ============================================
# CONFIGURAÇÕES DO SERVIDOR
# ============================================

# Porta do servidor Express
PORT=3000

# URL externa (Render ou outro host)
RENDER_EXTERNAL_URL=https://doguinha-store-bot.onrender.com

# ============================================
# CONFIGURAÇÕES DO BANCO DE DADOS
# ============================================

# Caminho do banco SQLite (local)
DATABASE_PATH=./src/database/doguinha_store.db

# ============================================
# CONFIGURAÇÕES DE LINKS
# ============================================

# Link do grupo de clientes no Telegram
TELEGRAM_GROUP_LINK=https://t.me/+oAYHMaqSAvtmMjNh

# Link do suporte no Telegram
SUPPORT_TELEGRAM_LINK=https://t.me/suporte_Annaa_Achadinhos

# ============================================
# CONFIGURAÇÕES DO SISTEMA DE INDICAÇÃO
# ============================================

# Porcentagem de bônus sobre recarga do indicado
REFERRAL_BONUS_PERCENTAGE=5

# ============================================
# CONFIGURAÇÕES DO PIX
# ============================================

# Tempo de expiração do PIX em minutos
PIX_EXPIRATION_MINUTES=15
